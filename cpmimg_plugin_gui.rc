/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_FORMAT_SELECT DIALOGEX 0, 0, 340, 220
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Choose image format"
FONT 12, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Choose image format",IDC_STATIC_TITLE,10,5,322,20
    LTEXT           "Select format:",IDC_STATIC_FORMAT,10,31,80,12
    COMBOBOX        IDC_COMBO_FORMAT,95,29,237,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Sector length:",IDC_STATIC_SECLENGTH,10,46,80,12
    EDITTEXT        IDC_EDIT_SECLENGTH,69,44,60,14,ES_RIGHT | ES_READONLY
    LTEXT           "Tracks:",IDC_STATIC_TRACKS,139,46,82,12
    EDITTEXT        IDC_EDIT_TRACKS,226,44,106,14,ES_RIGHT | ES_READONLY
    LTEXT           "Sectors/track:",IDC_STATIC_SECTRK,10,62,80,12
    EDITTEXT        IDC_EDIT_SECTRK,69,60,60,14,ES_RIGHT | ES_READONLY
    LTEXT           "Block size:",IDC_STATIC_BLKSIZ,139,62,82,12
    EDITTEXT        IDC_EDIT_BLKSIZ,226,60,106,14,ES_RIGHT | ES_READONLY
    LTEXT           "Max dir. entries:",IDC_STATIC_MAXDIR,10,78,80,12
    EDITTEXT        IDC_EDIT_MAXDIR,69,76,60,14,ES_RIGHT | ES_READONLY
    LTEXT           "Dir. blocks:",IDC_STATIC_DIRBLKS,139,78,82,12
    EDITTEXT        IDC_EDIT_DIRBLKS,226,76,106,14,ES_RIGHT | ES_READONLY
    LTEXT           "Boot track:",IDC_STATIC_BOOTTRK,10,94,80,12
    EDITTEXT        IDC_EDIT_BOOTTRK,69,92,60,14,ES_RIGHT | ES_READONLY
    LTEXT           "Probe score:",IDC_STATIC_PROBABILITY,139,94,82,12
    EDITTEXT        IDC_EDIT_PROBABILITY,226,92,106,14,ES_READONLY
    PUSHBUTTON      "Probe now",IDC_BUTTON_PROBE_NOW,10,111,80,14
    CONTROL         "Automatically probe future unknown images",IDC_CHECK_ENABLE_PROBING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,100,112,232,12
    CONTROL         "Save this probing preference permanently",IDC_CHECK_SAVE_PROBING,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,100,129,232,12
    CONTROL         "Use this disk type for other images in current session",IDC_CHECK_SAVE_TYPE_CUR,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,151,315,12
    CONTROL         "Save selected disk type to config file",IDC_CHECK_SAVE_TYPE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,168,300,12
    DEFPUSHBUTTON   "OK",IDOK,222,196,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,282,196,50,14
END


